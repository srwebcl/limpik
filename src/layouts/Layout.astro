---
import { ViewTransitions } from "astro:transitions";
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/outfit/wght.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import outfitLatin from "@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url";
import "../styles/global.css";
import ContactModal from "../components/forms/ContactModal.jsx";
import CookieConsent from "../components/CookieConsent.astro";
import {
	business,
	organizationSchema,
	websiteSchema,
} from "../data/business";

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	type?: "website" | "article";
	publishedTime?: Date;
	modifiedTime?: Date;
	noindex?: boolean;
	schema?: object | object[];
}

const {
	title,
	description,
	image = business.defaultImage,
	imageAlt = "Personal de limpieza Limpik trabajando en una oficina corporativa",
	type = "website",
	publishedTime,
	modifiedTime,
	noindex = false,
	schema = [],
} = Astro.props;

const site = Astro.site ?? new URL("https://www.limpik.cl");
const canonicalPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalURL = new URL(canonicalPath, site).href;
const imageURL = new URL(image, site).href;
const jsonLd = [
	organizationSchema,
	websiteSchema,
	...(Array.isArray(schema) ? schema : [schema]),
];
---

<!doctype html>
<html lang="es-CL">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<!-- Open Graph -->
		<meta property="og:site_name" content={business.name} />
		<meta property="og:locale" content="es_CL" />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={imageAlt} />
		{
			publishedTime && (
				<meta
					property="article:published_time"
					content={publishedTime.toISOString()}
				/>
			)
		}
		{
			modifiedTime && (
				<meta
					property="article:modified_time"
					content={modifiedTime.toISOString()}
				/>
			)
		}
		<meta name="twitter:card" content="summary_large_image" />

		<!-- Icons -->
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#0056b3" />
		<meta name="generator" content={Astro.generator} />
		<slot name="head" />

		<!-- Structured data -->
		<script
			is:inline
			type="application/ld+json"
			set:html={JSON.stringify(jsonLd)}
		/>

		<!-- Fuentes autoalojadas: Outfit (títulos) + Inter (texto) -->
		<link
			rel="preload"
			href={interLatin}
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href={outfitLatin}
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<ViewTransitions />
		<!--
			Consentimiento (Ley 21.719): todo parte denegado (Consent Mode v2)
			y GTM solo se carga si el usuario aceptó cookies de publicidad.
		-->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			window.gtag = function () {
				window.dataLayer.push(arguments);
			};
			window.gtag("consent", "default", {
				ad_storage: "denied",
				ad_user_data: "denied",
				ad_personalization: "denied",
				analytics_storage: "denied",
				functionality_storage: "denied",
				personalization_storage: "denied",
				security_storage: "granted",
			});
			window.gtag("set", "ads_data_redaction", true);
			window.__limpikLoadGTM = function () {
				if (window.__gtmLoaded) return;
				window.__gtmLoaded = true;
				window.dataLayer.push({
					"gtm.start": new Date().getTime(),
					event: "gtm.js",
				});
				var j = document.createElement("script");
				j.async = true;
				j.src = "https://www.googletagmanager.com/gtm.js?id=GTM-PDQTGRW3";
				document.head.appendChild(j);
			};
			try {
				var c = JSON.parse(localStorage.getItem("limpik_consent") || "null");
				if (
					c &&
					c.v === 1 &&
					c.ads &&
					Date.now() - c.ts < 365 * 24 * 60 * 60 * 1000
				) {
					window.gtag("consent", "update", {
						ad_storage: "granted",
						ad_user_data: "granted",
						ad_personalization: "granted",
					});
					window.__limpikLoadGTM();
				}
			} catch (e) {}
		</script>
	</head>
	<body>
		<slot />
		<ContactModal client:load />
		<CookieConsent />


		<script>
			// Simple Scroll Reveal Script
			const observerOptions = {
				root: null,
				rootMargin: "0px",
				threshold: 0.1,
			};

			const observer = new IntersectionObserver((entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add("visible");
						// Optional: Stop observing once revealed
						observer.unobserve(entry.target);
					}
				});
			}, observerOptions);

			// Function to init observer (runs on page load and after View Transitions)
			function initScrollReveal() {
				document.querySelectorAll(".reveal-on-scroll").forEach((el) => {
					observer.observe(el);
				});
			}

			// Run locally
			initScrollReveal();

			// CTAs de cotización (a[data-cta="cotizar"]):
			// - si la página tiene formulario ([data-quote-form]) → scroll suave hasta él
			// - si no → se abre el pop-up de cotización
			// Los enlaces normales a /contacto (sin data-cta) navegan a la página.
			function scrollToQuoteForm(target: HTMLElement) {
				const reduceMotion = window.matchMedia(
					"(prefers-reduced-motion: reduce)",
				).matches;
				// Si el formulario aún no "aparece" (reveal-on-scroll), se muestra sin animación
				// para que su posición final no cambie después de calcular el scroll
				const reveal = target.closest<HTMLElement>(".reveal-on-scroll:not(.visible)");
				if (reveal) {
					reveal.style.transition = "none";
					reveal.classList.add("visible");
					void reveal.offsetHeight;
					requestAnimationFrame(() => (reveal.style.transition = ""));
				}
				target.scrollIntoView({
					behavior: reduceMotion ? "auto" : "smooth",
					block: "start",
				});
				target.classList.remove("quote-highlight");
				void target.offsetWidth; // reinicia la animación
				target.classList.add("quote-highlight");
				// En escritorio se enfoca el primer campo; en táctil no, para no abrir el teclado
				if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
					setTimeout(() => {
						target
							.querySelector<HTMLElement>("input:not([type=hidden]):not([tabindex='-1']), select, textarea")
							?.focus({ preventScroll: true });
					}, reduceMotion ? 0 : 700);
				}
			}

			// Fase de captura: debe ejecutarse antes que el router de View Transitions,
			// que de lo contrario navega a /contacto antes de que esto actúe
			document.addEventListener("click", (e) => {
				if (
					e.button !== 0 ||
					e.metaKey ||
					e.ctrlKey ||
					e.shiftKey ||
					e.altKey
				) {
					return; // abrir en pestaña nueva, etc.
				}
				const anchor = (e.target as HTMLElement).closest<HTMLAnchorElement>(
					'a[data-cta="cotizar"]',
				);
				if (!anchor) return;
				e.preventDefault();

				const form = document.querySelector<HTMLElement>("[data-quote-form]");
				if (form) {
					scrollToQuoteForm(form);
					return;
				}

				const path = window.location.pathname;
				let service = "";
				if (path.includes("edificios")) service = "Limpieza de Edificios";
				else if (path.includes("empresas")) service = "Limpieza de Empresas";
				window.dispatchEvent(
					new CustomEvent("openContactModal", { detail: { service, trigger: anchor } }),
				);
			}, true);

			// Si se llega con #cotizar desde otra página, el formulario queda bajo el header fijo
			document.addEventListener("astro:page-load", () => {
				if (location.hash === "#cotizar") {
					const form = document.querySelector<HTMLElement>("[data-quote-form]");
					if (form) setTimeout(() => form.scrollIntoView({ block: "start" }), 50);
				}
			});

			// Re-run on View Transition navigation
			document.addEventListener("astro:page-load", () => {
				initScrollReveal();
			});
		</script>
	</body>
</html>
