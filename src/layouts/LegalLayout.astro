---
import Layout from "./Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { breadcrumbSchema } from "../data/business";

interface Props {
    title: string;
    heading: string;
    description: string;
    updated: string; // fecha legible, p. ej. "23 de septiembre de 2026"
}

const { title, heading, description, updated } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "");
const schema = breadcrumbSchema([
    { name: "Inicio", path: "/" },
    { name: heading, path },
]);
---

<Layout title={title} description={description} schema={schema}>
    <Header />

    <main class="main-content-spaced legal-page">
        <header class="legal-hero">
            <div class="container legal-container">
                <p class="legal-kicker">Información legal</p>
                <h1>{heading}</h1>
                <p class="legal-updated">Última actualización: {updated}</p>
            </div>
        </header>

        <article class="container legal-container legal-body">
            <slot />
        </article>
    </main>

    <Footer />
</Layout>

<style>
    .legal-hero {
        background: #f8fafc;
        border-bottom: 1px solid var(--color-border);
        padding: 4rem 0 2.5rem;
    }

    .legal-container {
        max-width: 820px;
        margin: 0 auto;
        padding-left: 1rem;
        padding-right: 1rem;
    }

    .legal-kicker {
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--color-secondary);
        margin-bottom: 0.5rem;
    }

    .legal-hero h1 {
        font-size: clamp(2rem, 4vw, 2.75rem);
        color: var(--color-primary);
        line-height: 1.15;
        margin-bottom: 0.75rem;
    }

    .legal-updated {
        color: #64748b;
        font-size: 0.95rem;
    }

    .legal-body {
        padding-top: 2.5rem;
        padding-bottom: 4rem;
        line-height: 1.75;
        font-size: 1.02rem;
        color: var(--color-text-main);
    }

    .legal-body :global(h2) {
        font-size: 1.45rem;
        color: var(--color-primary);
        margin: 2.5rem 0 0.75rem;
        scroll-margin-top: 110px;
    }

    .legal-body :global(h3) {
        font-size: 1.1rem;
        margin: 1.5rem 0 0.5rem;
    }

    .legal-body :global(p) {
        margin-bottom: 1rem;
    }

    .legal-body :global(ul),
    .legal-body :global(ol) {
        padding-left: 1.4rem;
        margin-bottom: 1rem;
    }

    .legal-body :global(li) {
        margin-bottom: 0.4rem;
    }

    .legal-body :global(a) {
        color: var(--color-primary);
        text-decoration: underline;
        overflow-wrap: anywhere;
    }

    .legal-body :global(.legal-toc) {
        background: #f8fafc;
        border: 1px solid var(--color-border);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 2rem;
    }

    .legal-body :global(.legal-toc ol) {
        margin: 0.5rem 0 0;
        columns: 2;
        column-gap: 2rem;
    }

    .legal-body :global(.table-wrap) {
        overflow-x: auto;
        margin-bottom: 1.5rem;
    }

    .legal-body :global(table) {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.92rem;
    }

    .legal-body :global(th),
    .legal-body :global(td) {
        text-align: left;
        vertical-align: top;
        padding: 0.65rem 0.75rem;
        border-bottom: 1px solid var(--color-border);
    }

    .legal-body :global(th) {
        background: #f1f5f9;
        font-weight: 600;
    }

    .legal-body :global(.legal-box) {
        border-left: 4px solid var(--color-primary);
        background: #f0f7ff;
        padding: 1rem 1.25rem;
        border-radius: 0 8px 8px 0;
        margin-bottom: 1.5rem;
    }

    .legal-body :global(.btn-cookie-settings) {
        display: inline-block;
        background: var(--color-primary);
        color: #fff;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 999px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
    }

    @media (max-width: 640px) {
        .legal-body :global(.legal-toc ol) {
            columns: 1;
        }
    }
</style>
