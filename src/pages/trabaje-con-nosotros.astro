---
import Layout from "../layouts/Layout.astro";
import { getImage } from "astro:assets";
import heroImg1 from "../assets/images/contacto.png";
import { breadcrumbSchema } from "../data/business";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WorkWithUsForm from "../components/forms/WorkWithUsForm.jsx";

const title = "Trabaja con Nosotros: Empleos de Limpieza | Limpik";
const description =
    "Postula a Limpik y súmate a nuestro equipo de limpieza profesional en Santiago y la V Región. Estabilidad laboral y capacitación continua.";
const schema = breadcrumbSchema([
    { name: "Inicio", path: "/" },
    { name: "Trabaje con Nosotros", path: "/trabaje-con-nosotros" },
]);
const heroImg1Bg = await getImage({ src: heroImg1, format: "webp", width: 1600, quality: 70 });
---

<Layout title={title} description={description} schema={schema}>
    <link
        slot="head"
        rel="preload"
        as="image"
        href={heroImg1Bg.src}
        fetchpriority="high"
    />
    <Header />

    <main class="main-content-spaced">
        <!-- Cinematic Hero (Recruitment) -->
        <section class="service-hero">
            <div class="hero-slideshow">
                <div
                    class="slide active"
                    style={`background-image: url('${heroImg1Bg.src}')`}
                >
                    <!-- Using same image as contact for now, or could use another generic office/cleaning image if available -->
                </div>
            </div>

            <div class="container">
                <div class="hero-content">
                    <h1 class="hero-title">
                        <span class="title-line title-top">Únete al</span>
                        <span class="title-line title-highlight">EQUIPO</span>
                        <span class="title-line title-bottom">Limpik</span>
                    </h1>

                    <p class="hero-description">
                        Desarrolla tu carrera en una empresa líder en servicios
                        de limpieza corporativa. Buscamos personas responsables
                        y comprometidas.
                    </p>
                </div>
            </div>
            <div class="overlay"></div>
        </section>

        <section class="section">
            <div class="container grid-contact">
                <!-- Left: Info Column -->
                <div class="info-col">
                    <span class="section-label">Postulaciones</span>
                    <h2>¿Buscas Estabilidad Laboral?</h2>
                    <p class="intro-p">
                        En Limpik valoramos el compromiso y la excelencia.
                        Ofrecemos un ambiente de trabajo profesional,
                        capacitación constante y oportunidades de crecimiento.
                    </p>

                    <div class="requirements-list">
                        <h3>Requisitos Generales:</h3>
                        <ul>
                            <li>Responsabilidad y puntualidad.</li>
                            <li>Compromiso con la calidad del servicio.</li>
                            <li>
                                Disponibilidad para trabajar en Santiago o V
                                Región.
                            </li>
                            <li>Antecedentes intachables.</li>
                        </ul>
                    </div>

                    <div class="contact-cards" style="margin-top: 2rem;">
                        <div class="contact-card-item">
                            <div class="icon-wrapper blue">
                                <svg
                                    width="24"
                                    height="24"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    ><path
                                        d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                                    ></path><polyline points="22,6 12,13 2,6"
                                    ></polyline></svg
                                >
                            </div>
                            <div class="text">
                                <span class="label">Dudas o Consultas</span>
                                <span class="value">rrhh@limpik.cl</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right: Form Column -->
                <div class="form-col">
                    <WorkWithUsForm client:load />
                </div>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<style>
    /* Reuse styles from contacto.astro mostly */

    /* --- Cinematic Hero Styles --- */
    .service-hero {
        position: relative;
        background-color: #000;
        height: 500px;
        display: flex;
        align-items: center;
        color: white;
        overflow: hidden;
    }

    .service-hero .container {
        max-width: 100%;
        width: 100%;
        margin: 0;
        padding-left: 8%;
        display: flex;
        justify-content: flex-start;
    }

    .hero-slideshow {
        position: absolute;
        inset: 0;
        z-index: 0;
        pointer-events: none;
    }

    .slide {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        opacity: 0;
        transform: scale(1);
        z-index: 0;
    }

    .slide.active {
        opacity: 1;
        z-index: 2;
        animation: kenBurns 30s ease-out forwards;
    }

    @keyframes kenBurns {
        0% {
            transform: scale(1) translate(0, 0);
        }
        100% {
            transform: scale(1.15) translate(-1%, -1%);
        }
    }

    .overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            90deg,
            rgba(30, 58, 138, 0.95) 0%,
            rgba(30, 58, 138, 0.8) 40%,
            rgba(30, 58, 138, 0.4) 100%
        );
        z-index: 1;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        max-width: 800px;
    }

    .hero-title {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        line-height: 1.1;
        margin-bottom: 2rem;
    }

    .title-line {
        display: block;
        opacity: 0;
        animation: slideUpFade 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .title-top {
        font-size: clamp(2rem, 3vw, 3rem);
        font-weight: 700;
        color: white;
        margin-bottom: 0.5rem;
        animation-delay: 0.1s;
    }

    .title-highlight {
        font-size: clamp(3rem, 5vw, 5rem);
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: -0.02em;
        position: relative;
        z-index: 1;
        animation-delay: 0.2s;
        background-image:
            linear-gradient(
                120deg,
                transparent 40%,
                rgba(255, 255, 255, 0.9) 50%,
                transparent 60%
            ),
            linear-gradient(135deg, #fb923c 0%, #f97316 50%, #ea580c 100%);
        background-size:
            200% auto,
            100% auto;
        background-position:
            200% center,
            center center;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        color: #f97316;
        animation:
            slideUpFade 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.2s,
            textShimmer 4s ease-in-out infinite alternate;
    }

    .title-bottom {
        font-size: clamp(1.8rem, 2.5vw, 2.5rem);
        font-weight: 600;
        color: rgba(255, 255, 255, 0.9);
        animation-delay: 0.3s;
    }

    .hero-description {
        font-size: 1.15rem;
        color: rgba(255, 255, 255, 0.9);
        max-width: 600px;
        margin-top: 1rem;
        line-height: 1.6;
        animation: slideUpFade 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.3s;
        opacity: 0;
    }

    @keyframes slideUpFade {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes textShimmer {
        0% {
            background-position:
                200% center,
                center center;
        }
        100% {
            background-position:
                -200% center,
                center center;
        }
    }

    @media (max-width: 900px) {
        .service-hero .container {
            justify-content: center;
            text-align: center;
            padding: 0 5%;
        }
        .hero-title {
            align-items: center;
            text-align: center;
        }
        .title-top {
            font-size: 1.5rem;
        }
        .title-highlight {
            font-size: 2.5rem;
            line-height: 1.1;
            margin-bottom: 0.5rem;
        }
        .title-bottom {
            font-size: 1.25rem;
        }
        .hero-description {
            margin: 1.5rem auto;
            font-size: 1rem;
            text-align: center;
        }
    }

    /* --- Content Section --- */
    .section {
        padding: 6rem 0;
        background-color: #f8fafc;
    }

    .grid-contact {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5rem;
        align-items: flex-start;
    }

    /* Info Column */
    .section-label {
        font-family: var(--font-heading);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-secondary);
        font-weight: 700;
        margin-bottom: 0.5rem;
        display: block;
    }

    .info-col h2 {
        font-size: 2.8rem;
        color: var(--color-primary);
        line-height: 1.1;
        margin-bottom: 1.5rem;
    }

    .intro-p {
        font-size: 1.1rem;
        color: var(--color-text-main);
        line-height: 1.8;
        margin-bottom: 3rem;
        max-width: 500px;
    }

    .requirements-list h3 {
        font-size: 1.2rem;
        color: var(--color-primary);
        margin-bottom: 1rem;
    }

    .requirements-list ul {
        list-style-type: disc;
        padding-left: 1.5rem;
    }

    .requirements-list li {
        font-size: 1.05rem;
        color: var(--color-text-main);
        margin-bottom: 0.5rem;
        line-height: 1.5;
    }

    /* Contact Cards */
    .contact-cards {
        display: flex;
        flex-direction: column;
        gap: 1.2rem;
    }

    .contact-card-item {
        display: flex;
        align-items: center;
        gap: 1.2rem;
        padding: 1.2rem;
        background: white;
        border-radius: 12px;
        border: 1px solid var(--color-border);
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .contact-card-item:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
        border-color: var(--color-secondary);
    }

    .icon-wrapper {
        width: 45px;
        height: 45px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }

    .icon-wrapper.blue {
        background: linear-gradient(135deg, #3b82f6, #2563eb);
    }

    .text {
        display: flex;
        flex-direction: column;
    }
    .text .label {
        font-size: 0.8rem;
        color: var(--color-text-light);
        text-transform: uppercase;
        font-weight: 600;
    }
    .text .value {
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--color-primary);
    }

    @media (max-width: 900px) {
        .grid-contact {
            grid-template-columns: 1fr;
            gap: 4rem;
        }
        .info-col h2 {
            font-size: 2.2rem;
        }
    }
</style>
