---
import { Image } from "astro:assets";
import logoImg from "../assets/images/logo.png";
import { business } from "../data/business";

const currentYear = new Date().getFullYear();
const phoneDisplay = "+56 9 8474 9397";
const mapsUrl = (lat: number, lng: number) =>
    `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;
---

<footer class="site-footer">
    <!-- Top Gradient Line -->
    <div class="footer-top-line"></div>

    <div class="container footer-grid">
        <!-- Col 1: Identity -->
        <div class="footer-brand-col">
            <a href="/" class="brand-header" aria-label="Limpik, ir al inicio">
                <Image
                    src={logoImg}
                    alt="Limpik"
                    class="logo-footer"
                    width={148}
                    height={45}
                    densities={[1, 2]}
                    format="webp"
                    loading="lazy"
                />
                <span class="tagline">Soluciones Corporativas</span>
            </a>
            <p class="description">
                Más de 18 años entregando servicios integrales de limpieza para
                empresas y edificios en Santiago, Viña del Mar, Valparaíso y
                Concón.
            </p>
        </div>

        <!-- Col 2: Services -->
        <nav class="footer-links-col" aria-label="Servicios">
            <h4>Servicios</h4>
            <ul>
                <li>
                    <a href="/servicios/limpieza-empresas"
                        >Limpieza de Empresas</a
                    >
                </li>
                <li>
                    <a href="/servicios/limpieza-edificios"
                        >Limpieza de Edificios</a
                    >
                </li>
                <li><a href="/contacto">Solicitar Cotización</a></li>
            </ul>
        </nav>

        <!-- Col 3: Corporate -->
        <nav class="footer-links-col" aria-label="Corporativo">
            <h4>Corporativo</h4>
            <ul>
                <li><a href="/nosotros">Nosotros</a></li>
                <li><a href="/noticias">Noticias & Blog</a></li>
                <li><a href="/trabaje-con-nosotros">Trabaje con Nosotros</a></li>
                <li><a href="/contacto">Contacto</a></li>
                <li>
                    <a href="/denuncias" class="highlight-link"
                        >Canal de Denuncias</a
                    >
                </li>
            </ul>
        </nav>

        <!-- Col 4: Contact Action -->
        <div class="footer-contact-col">
            <h4>Hablemos</h4>

            <a href={`tel:${business.telephone}`} class="contact-card">
                <div class="icon-box">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        ><path
                            d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
                        ></path></svg
                    >
                </div>
                <div class="contact-info">
                    <span class="label">Teléfono Ventas</span>
                    <span class="value">{phoneDisplay}</span>
                </div>
            </a>

            <div class="contact-details">
                <a
                    href={`https://wa.me/${business.whatsapp}`}
                    class="detail-link"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <span class="icon" aria-hidden="true">💬</span> WhatsApp {phoneDisplay}
                </a>
                <a href={`mailto:${business.email}`} class="detail-link">
                    <span class="icon" aria-hidden="true">📧</span> {business.email}
                </a>
                {
                    business.locations.map((loc) => (
                        <a
                            href={mapsUrl(loc.latitude, loc.longitude)}
                            class="detail-link"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <span class="icon" aria-hidden="true">📍</span>
                            {loc.streetAddress}, {loc.addressLocality}
                        </a>
                    ))
                }
                <p class="location">
                    <span class="icon" aria-hidden="true">🕘</span> Lunes a viernes,
                    09:00 a 18:00 hrs
                </p>
            </div>
        </div>
    </div>

    <div class="footer-legal">
        <nav class="container legal-links" aria-label="Información legal">
            <a href="/politica-de-privacidad">Política de Privacidad</a>
            <a href="/politica-de-cookies">Política de Cookies</a>
            <a href="/terminos-y-condiciones">Términos y Condiciones</a>
            <button type="button" class="cookie-settings-link" data-cookie-settings
                >Configuración de cookies</button
            >
        </nav>
    </div>

    <div class="footer-bottom">
        <div class="container bottom-flex">
            <p class="credits">
                Desarrollado con <span class="thunder">⚡</span> por <a
                    href="https://www.srweb.cl"
                    class="srweb-link"
                    target="_blank"
                    rel="noopener noreferrer">SRweb</a
                >
            </p>
            <p class="copyright">
                &copy; {currentYear} {business.legalName} · RUT {business.rut}. Todos
                los derechos reservados.
            </p>
        </div>
    </div>
</footer>

<style>
    .site-footer {
        background: linear-gradient(
            180deg,
            var(--color-primary) 0%,
            var(--color-primary-dark) 100%
        ) !important; /* Force Blue */
        color: #f1f5f9; /* Slate 100 - High contrast text */
        padding-top: 0;
        position: relative;
        overflow: hidden;
        font-family: var(--font-body);
    }

    .footer-top-line {
        height: 4px;
        width: 100%;
        background: linear-gradient(
            90deg,
            var(--color-primary) 0%,
            var(--color-secondary) 50%,
            var(--color-primary) 100%
        );
        box-shadow: 0 0 15px rgba(37, 99, 235, 0.5); /* Glow */
    }

    .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1.5fr; /* Optimized ratios */
        gap: 4rem;
        padding: 5rem 1rem;
        position: relative;
        z-index: 1;
    }

    /* Col 1: Brand */
    .footer-brand-col {
        display: flex;
        flex-direction: column;
        align-items: flex-start; /* Default Left for Desktop */
        text-align: left;
    }

    .brand-header {
        text-decoration: none;
        margin-bottom: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: flex-start; /* Default Left */
    }

    .logo-footer {
        height: 45px;
        width: auto;
        display: block;
        margin-bottom: 0.5rem;
        filter: brightness(0) invert(1);
    }

    .tagline {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.25em;
        color: var(--color-secondary);
        font-weight: 700;
        opacity: 0.9;
    }

    .description {
        line-height: 1.7;
        font-size: 0.95rem;
        color: white;
        margin-bottom: 2rem;
        max-width: 300px;
        text-align: left; /* Default Left */
    }


    /* Link Columns */
    h4 {
        color: white;
        font-size: 1.1rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        position: relative;
        display: inline-block;
    }

    .footer-links-col ul {
        list-style: none;
        padding: 0;
    }

    .footer-links-col li {
        margin-bottom: 1rem;
    }

    .footer-links-col a {
        color: #cbd5e1;
        text-decoration: none;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        display: inline-block;
        position: relative;
    }

    .footer-links-col a:hover {
        color: white;
        transform: translateX(5px);
    }

    .footer-links-col a::before {
        content: "›";
        position: absolute;
        left: -15px;
        opacity: 0;
        color: var(--color-secondary);
        transition: all 0.3s ease;
    }

    .footer-links-col a:hover::before {
        opacity: 1;
        left: -12px;
    }

    .highlight-link {
        color: var(--color-secondary) !important;
        font-weight: 500;
    }

    /* Contact Column */
    .contact-card {
        display: flex;
        align-items: center;
        gap: 1rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 1rem;
        border-radius: 12px;
        text-decoration: none;
        transition: all 0.3s ease;
        margin-bottom: 1.5rem;
    }

    .contact-card:hover {
        background: rgba(255, 255, 255, 0.08);
        border-color: var(--color-secondary);
        transform: translateY(-2px);
    }

    .icon-box {
        color: #25d366; /* WhatsApp Green */
        background: rgba(37, 211, 102, 0.1);
        width: 45px;
        height: 45px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s;
    }

    .contact-card:hover .icon-box {
        background: #25d366;
        color: white;
    }

    .contact-info {
        display: flex;
        flex-direction: column;
    }

    .contact-info .label {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: #94a3b8;
        letter-spacing: 0.05em;
    }

    .contact-info .value {
        color: white;
        font-weight: 700;
        font-size: 1.1rem;
    }

    .contact-details {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .detail-link,
    .location {
        color: #cbd5e1;
        font-size: 0.9rem;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.8rem;
        transition: color 0.3s;
    }

    .detail-link:hover {
        color: var(--color-secondary);
    }

    .icon {
        font-size: 1.1rem;
    }

    /* Legal links */
    .footer-legal {
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        padding: 1.25rem 0;
        position: relative;
        z-index: 1;
    }

    .legal-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 2rem;
        justify-content: center;
        font-size: 0.85rem;
    }

    .legal-links a,
    .cookie-settings-link {
        color: #cbd5e1;
        text-decoration: none;
        background: none;
        border: none;
        padding: 0;
        font: inherit;
        cursor: pointer;
        transition: color 0.3s;
    }

    .legal-links a:hover,
    .cookie-settings-link:hover {
        color: white;
        text-decoration: underline;
    }

    /* Footer Bottom */
    .footer-bottom {
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding: 2rem 0;
        position: relative;
        z-index: 1;
        background: rgba(0, 0, 0, 0.2);
    }

    .bottom-flex {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        font-size: 0.85rem;
        color: #94a3b8;
    }

    .thunder {
        animation: pulse 2s infinite;
        display: inline-block;
    }

    @keyframes pulse {
        0% {
            transform: scale(1);
            opacity: 0.7;
        }
        50% {
            transform: scale(1.3);
            opacity: 1;
            text-shadow: 0 0 10px #fb923c;
        }
        100% {
            transform: scale(1);
            opacity: 0.7;
        }
    }

    .srweb-link {
        color: #e2e8f0;
        text-decoration: none;
        font-weight: 600;
        transition: color 0.3s;
    }

    .srweb-link:hover {
        color: white;
    }

    /* Responsive */
    @media (max-width: 1024px) {
        .footer-grid {
            grid-template-columns: 1fr 1fr;
            gap: 3rem;
        }
    }

    @media (max-width: 640px) {
        .footer-grid {
            display: flex;
            flex-direction: column;
            gap: 3rem;
            text-align: center;
        }

        /* Mobile Centering Overrides */
        .footer-brand-col {
            align-items: center;
        }

        .brand-header {
            align-items: center;
        }

        .description {
            text-align: center;
            max-width: 100%;
        }

        .contact-details {
            align-items: center;
        }

        .footer-links-col a::before {
            display: none; /* Simplify on mobile */
        }

        .contact-card {
            justify-content: center;
            text-align: left;
        }

        .bottom-flex {
            flex-direction: column;
            gap: 1rem;
        }

        .credits {
            order: 1;
        }
        .copyright {
            order: 2;
        }
    }
</style>
